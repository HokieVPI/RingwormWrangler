%% data4 2

data4_2= importdata("test_3_20_3");
data4_2 = data4_2.data;
goalx = [];
goaly = [];
robotx = [];
roboty = [];
heading = [];
i = 1;
while i <= height(data4_2)-5
    goalx = [goalx; data4_2(i,1)];
    goaly = [goaly; data4_2(i+1,1)];
    robotx = [robotx; data4_2(i+2,1)];
    roboty = [roboty; data4_2(i+3,1)];
    heading = [heading; data4_2(i+4,1)];
    i = i+5;
end
robotx = robotx;
roboty = roboty;
figure
hold on
scatter(robotx,roboty)
scatter(goalx,goaly)
xlim([0, 2133.6])
ylim([0, 2641])

scatter([457.2, 762, 1066.8, 1066.8], [859.536, 1176.555, 859.536, 542.544],80,'green','filled')
scatter(xpoints,ypoints,'magenta',"filled")

